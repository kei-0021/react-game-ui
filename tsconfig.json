{
  "compilerOptions": {
    /* 基本設定 */
    "rootDir": "src",
    "outDir": "dist",
    "target": "ESNext",
    "module": "node16",
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* JS共存設定（ここが重要！） */
    "allowJs": true,
    "checkJs": false,

    /* 型定義の設定 */
    "declaration": true,
    "declarationDir": "dist/types",
    "emitDeclarationOnly": true,
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "types": ["node", "react", "react-dom"],

    /* パス解決 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/components",
    "src/types",
    "src/global.d.ts",
    "src/index.ts",
    "src/hooks",
    "src/server/server-utils"
  ],
  "exclude": [
    "node_modules",
    "src/__mocks__",
    "src/setupTests.ts",
    "src/components/__tests__",
    "tests/data"
  ]
}
