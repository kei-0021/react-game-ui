{
  "compilerOptions": {
    /* 基本設定 */
    "rootDir": "src",
    "outDir": "dist",
    "target": "ESNext",
    "module": "node16",
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* JS共存とビルド設定 */
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationMap": true,

    /* パス解決 */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* 型定義の参照 */
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "tests/data", "**/*.test.ts", "**/*.spec.ts"]
}
