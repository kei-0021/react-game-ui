{
  "compilerOptions": {
    /* 基本設定 */
    "rootDir": "src",
    "outDir": "dist",
    "target": "ESNext",
    "module": "node16",
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* JS共存とビルド設定 */
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationMap": true,

    /* パス解決 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* 型定義の参照 */
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "src/index.ts",
    "src/global.d.ts",
    "src/components/**/*",
    "src/hooks/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/server/**/*"
  ],
  "exclude": ["node_modules", "src/__mocks__", "src/setupTests.ts", "src/components/__tests__", "tests/data"]
}
