{
  "compilerOptions": {
    /* 基本設定 */
    "rootDir": "src",
    "outDir": "dist",
    "target": "ESNext",
    "module": "node16",
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* JS共存とビルド設定 */
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "declarationDir": "dist/types",
    "emitDeclarationOnly": false,
    "declarationMap": true, // 利用者が型定義からソースへジャンプ可能に

    /* パス解決 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* 型定義の参照 */
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "src/server/server-utils.ts",
    "src/types/**/*.ts",
    "src/global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/__mocks__",
    "src/setupTests.ts",
    "src/components/__tests__",
    "tests/data"
  ]
}
