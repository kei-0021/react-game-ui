{
  "name": "react-game-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "React + Socket.IO UI components for card/dice games",
  "main": "dist/react-game-ui.cjs.js",
  "module": "dist/react-game-ui.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-game-ui.es.js",
      "require": "./dist/react-game-ui.cjs.js"
    },
    "./server": {
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    },
    "./server-io-utils": {
      "types": "./dist/server/server-io-utils.d.ts",
      "import": "./dist/server/server-io-utils.js"
    },
    "./server-utils": {
      "types": "./dist/server/server-utils.d.ts",
      "import": "./dist/server/server-utils.js"
    },
    "./dist/react-game-ui.css": "./dist/react-game-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && vite build && cp -r src/assets/. dist/assets/ && tsc --project tsconfig.app.json",
    "preview": "vite preview",
    "server": "node --import tsx tests/server.ts",
    "dev:multi": "concurrently \"npm run server\" \"vite\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^5.1.0",
    "react-router-dom": "^7.9.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vitest": "^4.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "terser": "^5.44.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
